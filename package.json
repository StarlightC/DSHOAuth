{
  "name": "dsh-oauth",
  "version": "0.1.1",
  "description": "OAuth sign-in UI for the official DeepSeek Harness OpenAI Codex and GitHub Copilot providers",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.2 <0.3",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-alpha.2 <0.3",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-alpha.2 <0.3",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.2 <0.3",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.2 <0.3",
    "@deepseek-ai/dsh-client-ui-settings-models": ">=0.2.1-alpha.2 <0.3",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-alpha.2 <0.3",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-alpha.2 <0.3",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-alpha.2 <0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-alpha.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-test-renderer": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "^5.8.0"
  }
}
